# Server provider mode: "auto" (use live if keys present, else mock), "mock" (always demo)
PROVIDER_MODE=auto

# Gemini API configuration (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API configuration (server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Decision engine configuration
CONFIDENCE_THRESHOLD=0.65
RULESET_ID=houston-tx-curbside

# HTTP and security limits
MAX_UPLOAD_MB=8
RATE_LIMIT_PER_MIN=20

# Audio caching
AUDIO_CACHE_DIR=.cache/audio

# Application URL
APP_URL=http://localhost:3000

# Failure injection for testing (none | gemini | elevenlabs | both)
FORCE_FAILURE=none
