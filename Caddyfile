# Optional Plain VPS TLS Reverse Proxy Configuration
# Used alongside docker-compose.yml for automated Let's Encrypt certificates on a standalone VPS.
# For managed container hosting (Render, Cloud Run), see deploy/HOSTING.md.

{$DOMAIN:localhost} {
    encode gzip zstd

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        -Server
    }

    # Reverse proxy to the standalone Next.js application
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
