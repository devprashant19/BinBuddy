{
  "name": "binbuddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:rules": "node scripts/check-rules.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:api": "node scripts/check-api.mjs",
    "verify:fast": "npm run typecheck && npm run lint && npm run test && npm run check:rules && npm run check:secrets",
    "verify": "npm run verify:fast && npm run build && npm run test:e2e && npm run check:api",
    "screenshots": "node scripts/screenshots.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "warm:audio": "node scripts/warm-audio.mjs"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "elevenlabs": "^1.50.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
